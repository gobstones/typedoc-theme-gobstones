{
    "license": "./LICENSE_HEADER",
    "ignore": ["docs/", "test/", "dist/**/!(*.d.ts|*.js|*.cjs|*.mjs)", "**/!(*.ts|*.tsx)"],
    "defaultFormat": {
        "prepend": "/*",
        "append": "*/"
    },
    "licenseFormats": {
        "ts|tsx|js|jsx": {
            "prepend": "/*",
            "append": " */",
            "eachLine": {
                "prepend": " * "
            }
        }
    },
    "trailingWhitespace": "TRIM"
}

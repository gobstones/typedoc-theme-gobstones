{
    "compilerOptions": {
        "baseUrl": "src",
        "outDir": "./dist",
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "allowJs": true,
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
        "declarationDir": "./dist",
        "resolveJsonModule": true,
        "stripInternal": true,
        "composite": false,
        "skipLibCheck": true,
        "strictNullChecks": true,
        "jsx": "react",
        "jsxFactory": "JSX.createElement",
        "jsxFragmentFactory": "JSX.Fragment"
    },
    "include": ["src/**/*", "./src/@types/*.d.ts"],
    "exclude": ["node_modules", "web_modules", "**/*.spec.ts"]
}

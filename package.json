{
  "name": "@gobstones/typedoc-theme-gobstones",
  "description": "A simple theme for the Gobstones generated documentation.",
  "version": "0.5.1",
  "keywords": ["Gobstones", "typedoc-theme", "typedoc-theme-gobstones"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gobstones/typedoc-theme-gobstones.git"
  },
  "homepage": "https://gobtones.github.io/typedoc-theme-gobstones",
  "author": "Alan Rodas Bonjour <alanrodas@gmail.com>",
  "license": "AGPL-3.0",
  "type": "module",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "*": ["./dist/index.d.ts"]
    }
  },
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prepare": "is-ci || husky",
    "prepack": "npm start build",
    "start": "NODE_NO_WARNINGS=1 NODE_OPTIONS=--experimental-strip-types zx ./.scripts/_cli.ts"
  },
  "config": {
    "gobstones-scripts": {
      "type": "Library",
      "manager": "npm",
      "use-local-tsconfig-json": true
    }
  },
  "peerDependencies": {
    "typedoc": "^0.28.13"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/compat": "^1.4.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.36.0",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-image": "^3.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "commitizen": "^4.3.1",
    "concurrently": "^9.2.1",
    "conventional-changelog-cli": "^5.0.0",
    "copyfiles": "^2.4.1",
    "cpy-cli": "^6.0.0",
    "cross-env": "^10.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-null": "^1.0.2",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-refresh": "^0.4.21",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "license-check-and-add": "^4.0.5",
    "nps": "^5.10.0",
    "prettier": "^3.6.2",
    "prettier-plugin-ini": "^1.3.0",
    "prettier-plugin-sh": "^0.18.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.52.2",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-delete": "^3.0.1",
    "rollup-plugin-dts": "^6.2.3",
    "rollup-plugin-execute": "^1.1.1",
    "rollup-plugin-postcss": "^4.0.2",
    "serve": "^14.2.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "zx": "^8.8.3"
  },
  "dependencies": {
    "typedoc-plugin-mdn-links": "^5.0.9",
    "typedoc-plugin-merge-modules": "^7.0.0"
  }
}

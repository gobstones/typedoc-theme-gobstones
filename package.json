{
  "name": "@gobstones/typedoc-theme-gobstones",
  "description": "A simple theme for the Gobstones generated documentation.",
  "version": "0.4.0",
  "keywords": ["Gobstones", "typedoc-theme", "typedoc-theme-gobstones"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gobstones/typedoc-theme-gobstones.git"
  },
  "homepage": "https://gobtones.github.io/typedoc-theme-gobstones",
  "author": "Alan Rodas Bonjour <alanrodas@gmail.com>",
  "license": "AGPL-3.0",
  "type": "module",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "*": ["./dist/index.d.ts"]
    }
  },
  "packageManager": "npm@11.1.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "prepare": "is-ci || husky",
    "prepack": "npm start build",
    "start": "nps -c ./package-scripts.cjs"
  },
  "config": {
    "gobstones-scripts": {
      "type": "Library",
      "manager": "npm",
      "use-local-tsconfig-json": true
    }
  },
  "peerDependencies": {
    "typedoc": "^0.27.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@eslint/compat": "^1.2.6",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.19.0",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-image": "^3.0.3",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "commitizen": "^4.3.1",
    "concurrently": "^9.1.2",
    "conventional-changelog-cli": "^5.0.0",
    "copyfiles": "^2.4.1",
    "cpy-cli": "^5.0.0",
    "cross-env": "^7.0.3",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-no-null": "^1.0.2",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react-refresh": "^0.4.18",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "license-check-and-add": "^4.0.5",
    "nps": "^5.10.0",
    "prettier": "^3.4.2",
    "prettier-plugin-ini": "^1.3.0",
    "prettier-plugin-sh": "^0.14.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.34.4",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-delete": "^2.1.0",
    "rollup-plugin-dts": "^6.1.1",
    "rollup-plugin-execute": "^1.1.1",
    "rollup-plugin-postcss": "^4.0.2",
    "serve": "^14.2.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.23.0"
  },
  "dependencies": {
    "typedoc-plugin-mdn-links": "^4.0.11",
    "typedoc-plugin-merge-modules": "^6.1.0"
  }
}
